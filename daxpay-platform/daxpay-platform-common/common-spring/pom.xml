            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- 项目配置 -->
        <dependency>
            <groupId>org.dromara.daxpay</groupId>
            <artifactId>common-config</artifactId>
            <version>${project.version}</version>
        </dependency>
