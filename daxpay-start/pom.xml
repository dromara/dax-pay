<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.daxpay.open</groupId>
        <artifactId>daxpay</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>daxpay-start</artifactId>
    <packaging>jar</packaging>
    <description>多商户启动终端</description>

    <dependencies>
        <!-- web框架 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 监控端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 链路追踪(OpenTelemetry, 仅日志关联, 不导出) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 支付公共底座（核心交易引擎 + 商户领域共享内核 + 网关订单模型） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 运营管理端（控制器 + 管理服务） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-admin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 支付网关端（下单/退款/转账/查询/聚合支付） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 商户自助端（商户管理自己资源/订单的控制器） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-merchant</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 功能演示模块（需隔离时注释此依赖即可从产物中剔除） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-demo</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 数据库驱动 PG -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 支付通道 -->
        <!-- 支付宝通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-alipay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 微信支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-wechat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 银联商务通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-ums</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 拉卡拉通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-lakala</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 抖音支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-douyin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 海科融通通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-hkrt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 斗拱(汇付天下)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-dougong</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 随行付(天阙科技)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-vbill</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 乐刷通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-leshua</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 富友支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-fuyou</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 河马付(杉德)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-hmpay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Adapay(汇付天下)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-adapay</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>daxpay-union</finalName>
        <plugins>
            <!-- spring-boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
