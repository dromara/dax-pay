<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.daxpay.open</groupId>
        <artifactId>daxpay</artifactId>
        <version>4.0.0-beta9</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>daxpay-start</artifactId>
    <packaging>jar</packaging>
    <description>多商户启动终端</description>

    <dependencies>
        <!-- web框架 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 监控端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 链路追踪(OpenTelemetry, 仅日志关联, 不导出) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 支付域内核（交易引擎 + 商户领域 + 网关订单模型 + 开放 API 契约） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 运营管理端（控制器 + 管理服务） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-admin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 运营移动端 APP/小程序（/app-admin/**，转发 admin/common Service） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-app-admin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 商户移动端 APP/小程序（/app-merchant/**，转发 merchant/admin/core Service） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-app-merchant</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 开放支付端（统一收单/网关产品/公开 H5） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-unipay</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 商户自助端（商户管理自己资源/订单的控制器） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-payment-merchant</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 功能演示模块（需隔离时注释此依赖即可从产物中剔除） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-demo</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 数据库驱动 PG -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 支付通道 -->
        <!-- 支付宝通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-alipay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 微信支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-wechat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 银联商务通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-ums</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 拉卡拉通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-lakala</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 盛付通通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-sheng</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 抖音支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-douyin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 海科融通通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-hkrt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 斗拱(汇付天下)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-dougong</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 随行付(天阙科技)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-vbill</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 乐刷通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-leshua</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 富友支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-fuyou</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 河马付(杉德)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-hmpay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Adapay(汇付天下)通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-adapay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 云闪付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-union</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 易宝支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-yeepay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 快钱支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-kuaiqian</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 一直付(北京)支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-yizhifubj</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 连连支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-llianpay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 建行龙支付通道(建设银行聚合支付) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-long</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 杉德支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-sand</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Stripe 国际卡组通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-stripe</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 易支付通道(三方聚合平台) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-easypay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 收钱吧支付通道 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-shouqianba</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 星驿付支付通道(新大陆旗下国通星驿, 驿云付 YYF 接口) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-xingyi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 银盛支付通道(一通道两产品: 银盛支付开放平台 ysep_pay + 银盛e企通 yseqt_pay) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-ysep</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Jeepay计全支付通道(三方聚合平台: 微信/支付宝/云闪付) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-jeepay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 合利宝支付通道(扫码产品线: 微信/支付宝扫码+公众号JS+H5) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-helipay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 付呗聚合支付通道(云闪付扫码/微信JSAPI/支付宝JSAPI/支付宝H5, 开放平台网关 JSON+MD5) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-fubei</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 嘉联支付通道(聚合通道: 微信/支付宝/云闪付, OpenAPI 国密 SM2 直连商户模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-jlpay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 易票联支付通道(聚合通道: 微信/支付宝/云闪付扫码+JSAPI+网银收银台, EFPS 网关直连商户模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-epaylinks</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 联动优势支付通道(聚合通道: 微信/支付宝/云闪付扫码+微信公众号跳转, 老网关表单+RSA(SHA1)签名直连商户模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-umfpay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 易生支付通道(聚合通道: 微信/支付宝扫码+JSAPI, api_gateway.do 表单+RSA 类支付宝协议直连商户模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-yisheng</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 中金支付通道(聚合通道: 微信/支付宝/云闪付扫码+微信JSAPI/H5+支付宝JSAPI, 国密 SM2 证书签名直连机构模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-cpcn</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 宝付支付通道(聚合通道: 微信/支付宝/云闪付收银台+扫码+JSAPI+付款码, 聚合 juhe 网关表单+RSA(SHA256 hex) 直连商户模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-baofu</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 哆啦宝支付通道(聚合通道: 微信/支付宝/云闪付扫码+H5+JSAPI, 开放平台 JSON+SHA1 token 直连商户模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-duolabao</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 有赞支付通道(高汇通聚合通道: 微信JSAPI/小程序/H5 + 支付宝JSAPI, youzan.pay.unified 统收单线 RSA 头签名直连商户模式) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-youzan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 易支付协议插件 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-plugin-easypay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 支付风控插件（黑名单 + 命中记录） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-plugin-risk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 敏感词过滤（词库 + 命中 + 运行时校验；service-system 已传递引入，此处显式保证装配） -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>capability-sensitive-word</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 单元测试（版本由 spring-boot-starter-parent BOM 管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>daxpay-union</finalName>
        <plugins>
            <!-- spring-boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
